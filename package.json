{
  "name": "oauth2api",
  "version": "0.9.11",
  "private": true,
  "description": "OAuth-to-API proxy fork for Jeedom ai_auth2api",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "login": "tsx src/index.ts --login",
    "test": "tsx --test tests/*.test.ts",
    "test:smoke": "tsx --test tests/smoke.test.ts",
    "prettier": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "express": "^4.21.0",
    "js-yaml": "^4.1.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@types/uuid": "^10.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
